        "jsCode": "const item = $input.first().json;\nlet stale;\nif (item.is_stale === true) stale = 'stale';\nelse if (item.is_stale === false) stale = 'fresh';\nelse stale = 'unknown';\nconst alert_code = stale === 'stale' ? 'stale_pending' : stale === 'unknown' ? 'stale_state_unknown' : '';\nreturn [{ json: { ...item, stale, alert_code } }];"
