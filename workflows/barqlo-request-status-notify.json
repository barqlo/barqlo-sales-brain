    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed AS (\n UPDATE public.request_notifications rn\n SET delivery_status='sending', attempts=attempts+1, lease_until=now()+interval '2 minutes', last_error=null\n FROM public.customer_requests cr, public.customer_identities ci, public.channels ch\n WHERE rn.id=$1::uuid AND rn.tenant_id=$2::uuid AND rn.request_id=cr.id\n AND cr.tenant_id=rn.tenant_id AND cr.status=rn.event_status\n AND ci.tenant_id=rn.tenant_id AND ci.customer_id=cr.customer_id AND ci.provider='telegram'\n AND ch.tenant_id=rn.tenant_id AND ch.provider='telegram' AND ch.active=true AND ch.adapter_secret=$3::text\n AND rn.delivery_status='pending'\n RETURNING rn.id AS notification_id, rn.tenant_id, rn.event_status, cr.request_kind, cr.payload, cr.subtotal, cr.currency, ci.channel_user_id, ch.external_id\n)\nSELECT * FROM claimed;",
        "options": {
          "queryReplacement": "={{ $json.body.notification_id }},{{ $json.body.tenant_id }},{{ $json.body.secret }}"
        }
      },
      "id": "6478ca21-2782-4806-b266-14168534f3f3",
      "name": "Claim Notification",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        224,
        208
      ],
      "credentials": {
        "postgres": {
