          "name": "BarqBrainv1 Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;\nif (!r || !r.notification_id || !r.channel_user_id) return [];\nconst cart=Array.isArray(r.payload?.cart)?r.payload.cart:[];\nconst lines=cart.slice(0,20).map(x=>'• '+String(x.name||'الصنف')+' × '+Number(x.quantity||1)).join('\\n');\nconst kind=r.request_kind==='order'?'طلبك':r.request_kind==='booking'?'طلب الحجز':r.request_kind==='viewing'?'طلب المعاينة':'طلبك';\nconst status=r.event_status==='confirmed'?'اتأكد من الفريق ✅':r.event_status==='completed'?'اكتمل ✅':'اتلغى بعد مراجعة الفريق.';\nlet body=kind+' '+status+'\\nرقم المتابعة: '+String(r.notification_id).slice(0,8);\nif (lines) body+='\\n'+lines;\nif (r.request_kind==='order' && r.subtotal!=null) body+='\\nإجمالي الأصناف: '+Number(r.subtotal)+(r.currency==='EGP'?' جنيه':' '+String(r.currency||''));\nif (r.event_status==='confirmed') body+='\\nلو محتاج تفاصيل الموعد أو الاستلام، فريق النشاط هيكمل معاك.';\nreturn [{json:{notification_id:r.notification_id,tenant_id:r.tenant_id,external_id:r.external_id,chat_id:r.channel_user_id,text:body}}];"
      },
